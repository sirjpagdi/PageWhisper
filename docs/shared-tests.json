       "matchCase": false
      }
     ]
    }
   },
   "key": "other.test/novel/x",
   "input": "Lin smiled.",
   "expected": "Leen smiled."
  },
  {
   "name": "inside words when whole-word is off",
   "rules": {
    "global": [
     {
      "from": "xuan",
      "to": "shwen",
      "whole": false,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Longxuan and Xuanwu",
   "expected": "Longshwen and Shwenwu"
  },
  {
   "name": "whole word does not touch part of a longer word",
   "rules": {
    "global": [
     {
      "from": "Lin",
      "to": "Leen",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Lin, Linda and Berlin",
   "expected": "Leen, Linda and Berlin"
  },
  {
   "name": "match case",
   "rules": {
    "global": [
     {
      "from": "Ai",
      "to": "Eye",
      "whole": true,
      "matchCase": true
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Ai and ai and AI",
   "expected": "Eye and ai and AI"
  },
  {
   "name": "longest written form is tried first",
   "rules": {
    "global": [
     {
      "from": "Yu",
      "to": "Yoo",
      "whole": true,
      "matchCase": false
     },
     {
      "from": "Yu Longxuan",
      "to": "Yoo Long shwen",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Yu Longxuan met Yu Wenzhao.",
   "expected": "Yoo Long shwen met Yoo Wenzhao."
  },
  {
   "name": "empty replacement makes it silent",
   "rules": {
    "global": [
     {
      "from": "[Ding!]",
      "to": "",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "A [Ding!] chime.",
   "expected": "A  chime."
  },
  {
   "name": "capital letter carries over to the replacement",
   "rules": {
    "global": [
     {
      "from": "dao",
      "to": "dow",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Dao is the way. dao.",
   "expected": "Dow is the way. dow."
  },
  {
   "name": "accented letters count as letters",
   "rules": {
    "global": [
     {
      "from": "Xiǎo",
      "to": "Shyow",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Xiǎo Yu and Xiǎoyu",
   "expected": "Shyow Yu and Xiǎoyu"
  },
  {
   "name": "dollar signs in the replacement stay literal",
   "rules": {
    "global": [
     {
      "from": "Gold",
      "to": "$1 gold",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Gold and gold",
   "expected": "$1 gold and $1 gold"
  },
  {
   "name": "no rules changes nothing",
   "rules": {
    "global": [],
    "novels": {}
   },
   "key": "",
   "input": "Nothing to fix here.",
   "expected": "Nothing to fix here."
  }
 ],
