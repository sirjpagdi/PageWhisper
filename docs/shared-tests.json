 "schema": 1,
 "pronunciation": [
  {
   "name": "whole word, any case, keeps punctuation",
   "rules": {
    "global": [
     {
      "from": "Longxuan",
      "to": "Long shwen",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {}
   },
   "key": "",
   "input": "Yu Longxuan drew his sword. Longxuan's eyes narrowed; LONGXUAN! longxuan?",
   "expected": "Yu Long shwen drew his sword. Long shwen's eyes narrowed; Long shwen! Long shwen?"
  },
  {
   "name": "rule for this novel beats the global rule",
   "rules": {
    "global": [
     {
      "from": "Lin",
      "to": "Leen",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {
     "novels.test/novel/blue-moon": [
      {
       "from": "Lin",
       "to": "Lynn",
       "whole": true,
       "matchCase": false
      }
     ]
    }
   },
   "key": "novels.test/novel/blue-moon",
   "input": "Lin smiled.",
   "expected": "Lynn smiled."
  },
  {
   "name": "same rules, a different novel uses the global rule",
   "rules": {
    "global": [
     {
      "from": "Lin",
      "to": "Leen",
      "whole": true,
      "matchCase": false
     }
    ],
    "novels": {
     "novels.test/novel/blue-moon": [
      {
       "from": "Lin",
       "to": "Lynn",
